{
  "version": "1.0",
  "status": "APPROVED_FOR_PROTOTYPE",
  "body_columns": 2,
  "column_gutter_mm": 6,
  "span_styles": [
    "P_Article_Title",
    "P_Author",
    "P_Feature_Lead",
    "P_Feature_Section",
    "P_Feature_Media",
    "P_Feature_Caption"
  ],
  "body": {
    "family": "serif_cn",
    "weight": "Regular",
    "size_pt": 9.4,
    "leading_pt": 16.5,
    "first_line_indent_em": 2.0,
    "color": "C_TEXT"
  },
  "lead": {
    "family": "serif_cn",
    "weight": "Regular",
    "size_pt": 11.0,
    "leading_pt": 18.0,
    "space_after_mm": 5.0,
    "color": "C_TEXT"
  },
  "section": {
    "family": "serif_cn",
    "weight": "SemiBold",
    "size_pt": 14.0,
    "leading_pt": 21.0,
    "space_before_mm": 6.0,
    "space_after_mm": 3.5,
    "color": "C_TEXT",
    "rule_above": {
      "weight_pt": 0.45,
      "color": "C_SDU_RED",
      "offset_mm": 5.0
    }
  },
  "caption": {
    "family": "sans_cn",
    "weight": "Regular",
    "size_pt": 7.5,
    "leading_pt": 11.0,
    "space_before_mm": 1.0,
    "space_after_mm": 4.0,
    "color": "C_MUTED"
  },
  "media": {
    "space_before_mm": 4.0,
    "space_after_mm": 1.0
  }
